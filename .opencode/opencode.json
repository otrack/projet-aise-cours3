{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/ministral-3:3b-32k",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "ministral-3:3b-32k": {
          "name": "Ministral 3 3B (32k context)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    },
    "ollama-trace": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (traced by trace.py)",
      "options": {
        "baseURL": "http://127.0.0.1:11435/v1"
      },
      "models": {
        "ministral-3:3b-32k": {
          "name": "Ministral 3 3B (32k context, traced)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    },
    "mistral-trace": {
      "npm": "@ai-sdk/mistral",
      "name": "Mistral (traced by trace.py)",
      "options": {
        "baseURL": "http://127.0.0.1:11436/v1",
        "apiKey": "replaced-by-trace.py"
      },
      "models": {
        "ministral-3b-latest": {
          "name": "Ministral 3B (traced)",
          "limit": {
            "context": 131072,
            "output": 8192
          }
        }
      }
    }
  },
  "agent": {
    "build": {
      "permission": {
        "edit": "ask",
        "bash": "ask"
      }
    }
  }
}
